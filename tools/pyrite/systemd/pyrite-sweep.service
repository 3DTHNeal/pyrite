[Unit]
Description=Pyrite: sweep job boards for new postings
After=network-online.target

[Service]
Type=oneshot
# The workspace comes from .pyrite-home in this folder, or set Environment=PYRITE_HOME=...
WorkingDirectory=%h/pyrite
# The same sweep as the dashboard's button: it reads the boards, then checks mail, and claims the run first so the two
# can't overlap. Trouble reading mail never fails it; that shows on the dashboard instead.
ExecStart=%h/pyrite/.venv/bin/python tools/pyrite.py sweep
Nice=10
