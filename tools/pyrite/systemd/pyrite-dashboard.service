[Unit]
Description=Pyrite dashboard (localhost only)

[Service]
# The workspace comes from .pyrite-home in this folder, or set Environment=PYRITE_HOME=...
WorkingDirectory=%h/pyrite
# The .venv that docs/operating.md has you create, so building documents works from the dashboard too.
# The port is port under [dashboard] in search.toml, 8787 if unset.
ExecStart=%h/pyrite/.venv/bin/python tools/pyrite.py serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
